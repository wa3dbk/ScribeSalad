56><c>how </c><00:00:01.358><c>synapses </c><00:00:01.360><c>can </c><00:00:01.362><c>change </c><00:00:01.364><c>over  </c><00:00:01.366><c>time </c><00:00:01.368><c>in </c><00:00:01.370><c>response </c><00:00:01.372><c>to </c><00:00:01.374><c>external </c><00:00:01.376><c>stimuli  </c><00:00:01.378><c>playing </c><00:00:01.380><c>a </c><00:00:01.382><c>foundational </c><00:00:01.384><c>role </c><00:00:01.386><c>in </c><00:00:01.388><c>how </c><00:00:01.390><c>we  </c><00:00:01.392><c>learn </c><00:00:01.394><c>and </c><00:00:01.396><c>remember  </c><00:00:01.398><c>[Music]  </c><00:00:01.400><c>you</c>

