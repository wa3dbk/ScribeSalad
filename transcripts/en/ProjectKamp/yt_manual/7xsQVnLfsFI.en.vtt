𝘐𝘧 𝘺𝘰𝘶 𝘭𝘪𝘬𝘦 𝘸𝘩𝘢𝘵 𝘸𝘦 𝘥𝘰, 𝘺𝘰𝘶 𝘤𝘢𝘯 𝘴𝘶𝘱𝘱𝘰𝘳𝘵 𝘶𝘴 𝘰𝘯 𝘗𝘢𝘵𝘳𝘦𝘰𝘯.

00:30:53.639 --> 00:30:55.960
𝘠𝘰𝘶𝘳 𝘩𝘦𝘭𝘱 𝘸𝘪𝘭𝘭 𝘣𝘦 𝘳𝘦𝘢𝘭𝘭𝘺 𝘢𝘱𝘱𝘳𝘦𝘤𝘪𝘢𝘵𝘦𝘥.

00:30:55.960 --> 00:30:59.071
𝘞𝘦 𝘸𝘪𝘭𝘭 𝘱𝘰𝘴𝘵 𝘴𝘰𝘮𝘦 𝘦𝘹𝘤𝘭𝘶𝘴𝘪𝘷𝘦 𝘗𝘢𝘵𝘳𝘦𝘰𝘯 𝘤𝘰𝘯𝘵𝘦𝘯𝘵
𝘥𝘶𝘳𝘪𝘯𝘨 𝘵𝘩𝘦 𝘸𝘪𝘯𝘵𝘦𝘳.

00:30:59.071 --> 00:31:02.258
𝘈𝘯𝘥, 𝘺𝘰𝘶 𝘨𝘦𝘵 𝘰𝘯𝘦 𝘰𝘧 𝘰𝘶𝘳 𝘯𝘪𝘤𝘦 𝘗𝘳𝘰𝘫𝘦𝘤𝘵 𝘒𝘢𝘮𝘱 𝘣𝘢𝘥𝘨𝘦𝘴. 

00:31:03.680 --> 00:31:07.719
𝘕𝘰𝘸, 𝘸𝘦 𝘢𝘳𝘦 𝘨𝘰𝘪𝘯𝘨 𝘵𝘰 𝘱𝘳𝘦𝘱𝘢𝘳𝘦 𝘢 𝘯𝘪𝘤𝘦 𝘥𝘪𝘯𝘯𝘦𝘳,
𝘵𝘰 𝘤𝘦𝘭𝘦𝘣𝘳𝘢𝘵𝘦 𝘵𝘩𝘦 𝘦𝘯𝘥 𝘰𝘧 𝘵𝘩𝘦 𝘴𝘦𝘢𝘴𝘰𝘯.

00:31:07.719 --> 00:31:09.761
𝘈𝘯𝘥, 𝘢𝘭𝘭 𝘵𝘩𝘦 𝘩𝘢𝘳𝘥 𝘸𝘰𝘳𝘬 𝘵𝘩𝘢𝘵 𝘩𝘢𝘴 𝘣𝘦𝘦𝘯 𝘥𝘰𝘯𝘦. 

00:31:10.510 --> 00:31:11.779
𝘛𝘩𝘢𝘯𝘬𝘴 𝘧𝘰𝘳 𝘸𝘢𝘵𝘤𝘩𝘪𝘯𝘨!

00:31:12.075 --> 00:31:13.904
𝘈𝘯𝘥, 𝘴𝘦𝘦 𝘺𝘰𝘶 𝘴𝘰𝘰𝘯.

00:31:27.668 --> 00:31:30.580
𝘐𝘵'𝘴 𝘣𝘦𝘦𝘯 𝘢𝘯 𝘪𝘯𝘵𝘦𝘯𝘴𝘦 𝘺𝘦𝘢𝘳, 𝘣𝘶𝘵 𝘸𝘦'𝘳𝘦 𝘩𝘢𝘱𝘱𝘺.

00:31:30.580 --> 00:31:32.920
𝘔𝘢𝘯𝘺 𝘵𝘩𝘪𝘯𝘨𝘴 𝘢𝘳𝘦 𝘣𝘶𝘪𝘭𝘵 𝘢𝘯𝘥 𝘪𝘮𝘱𝘳𝘰𝘷𝘦𝘥.

00:31:33.660 --> 00:31:36.940
𝘛𝘩𝘦 𝘮𝘢𝘪𝘯 𝘨𝘰𝘢𝘭 𝘸𝘢𝘴: 𝘵𝘩𝘪𝘴 𝘺𝘦𝘢𝘳, 𝘪𝘯𝘵𝘦𝘨𝘳𝘢𝘵𝘪𝘯𝘨
𝘮𝘰𝘳𝘦 𝘱𝘦𝘰𝘱𝘭𝘦 𝘰𝘯 𝘵𝘩𝘪𝘴 𝘣𝘪𝘨 𝘭𝘢𝘯𝘥.

00:31:36.940 --> 00:31:39.279
𝘈𝘯𝘥, 𝘮𝘢𝘯𝘺 𝘤𝘢𝘮𝘦 𝘧𝘳𝘰𝘮 𝘥𝘪𝘧𝘧𝘦𝘳𝘦𝘯𝘵 𝘤𝘰𝘶𝘯𝘵𝘳𝘪𝘦𝘴, 𝘢𝘯𝘥
𝘣𝘢𝘤𝘬𝘨𝘳𝘰𝘶𝘯𝘥𝘴.

00:31:39.279 --> 00:31:42.040
𝘈𝘯𝘥, 𝘩𝘦𝘭𝘱𝘦𝘥 𝘸𝘪𝘵𝘩 𝘵𝘩𝘦𝘪𝘳 𝘦𝘯𝘦𝘳𝘨𝘺, 𝘢𝘯𝘥 𝘢𝘮𝘢𝘻𝘪𝘯𝘨 𝘴𝘬𝘪𝘭𝘭𝘴. 

00:31:43.848 --> 00:31:46.210
𝘞𝘦 𝘴𝘩𝘢𝘳𝘦𝘥, 𝘸𝘰𝘳𝘬𝘦𝘥 𝘢𝘯𝘥 𝘦𝘯𝘫𝘰𝘺𝘦𝘥 𝘣𝘦𝘪𝘯𝘨 𝘵𝘰𝘨𝘦𝘵𝘩𝘦𝘳.

00:31:46.210 --> 00:31:48.150
𝘉𝘶𝘵, 𝘵𝘩𝘦𝘳𝘦'𝘴 𝘴𝘵𝘪𝘭𝘭 𝘢 𝘭𝘰𝘵 𝘮𝘰𝘳𝘦 𝘵𝘰 𝘥𝘰.

00:31:48.150 --> 00:31:49.799
𝘞𝘦 𝘸𝘢𝘯𝘵 𝘵𝘰 𝘭𝘪𝘷𝘦 𝘪𝘯 𝘢 𝘮𝘰𝘳𝘦 𝘴𝘶𝘴𝘵𝘢𝘪𝘯𝘢𝘣𝘭𝘦 𝘸𝘢𝘺.

00:31:49.799 --> 00:31:52.299
𝘈𝘥𝘷𝘢𝘯𝘤𝘦 𝘰𝘶𝘳 𝘬𝘯𝘰𝘸𝘭𝘦𝘥𝘨𝘦, 
𝘢𝘯𝘥 𝘴𝘩𝘢𝘳𝘦 𝘪𝘵 𝘸𝘪𝘵𝘩 𝘵𝘩𝘦 𝘸𝘰𝘳𝘭𝘥.

00:31:52.299 --> 00:31:55.480
𝘐𝘵'𝘴 𝘢 𝘭𝘰𝘯𝘨 𝘵𝘢𝘴𝘬 𝘢𝘩𝘦𝘢𝘥,
𝘢𝘯𝘥 𝘮𝘢𝘯𝘺 𝘤𝘩𝘢𝘭𝘭𝘦𝘯𝘨𝘦𝘴 𝘤𝘰𝘮𝘪𝘯𝘨.

