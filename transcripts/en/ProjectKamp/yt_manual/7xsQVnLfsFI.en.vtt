𝘉𝘶𝘵 𝘧𝘪𝘳𝘴𝘵, 𝘸𝘦 𝘯𝘦𝘦𝘥 𝘴𝘰𝘮𝘦 𝘳𝘦𝘴𝘵.

00:31:57.400 --> 00:32:00.860
𝘞𝘦 𝘯𝘰𝘸 𝘩𝘢𝘷𝘦 𝘢 𝘣𝘳𝘦𝘢𝘬 𝘧𝘰𝘳 𝘴𝘰𝘮𝘦 𝘮𝘰𝘯𝘵𝘩𝘴 𝘵𝘰 𝘱𝘳𝘦𝘱𝘢𝘳𝘦,
𝘢𝘯𝘥 𝘱𝘭𝘢𝘯 𝘵𝘩𝘦 𝘯𝘦𝘹𝘵 𝘴𝘦𝘢𝘴𝘰𝘯.

00:32:00.860 --> 00:32:04.990
𝘝𝘪𝘥𝘦𝘰𝘴 𝘸𝘪𝘭𝘭 𝘤𝘰𝘮𝘦 𝘣𝘢𝘤𝘬 𝘪𝘯 𝘈𝘱𝘳𝘪𝘭, 𝘸𝘪𝘵𝘩 𝘮𝘢𝘯𝘺
𝘣𝘪𝘨 𝘯𝘦𝘸 𝘱𝘳𝘰𝘫𝘦𝘤𝘵𝘴, 𝘢𝘯𝘥 𝘦𝘹𝘱𝘦𝘳𝘪𝘮𝘦𝘯𝘵𝘴.

00:32:04.990 --> 00:32:06.749
𝘓𝘰𝘰𝘬𝘪𝘯𝘨 𝘧𝘰𝘳𝘸𝘢𝘳𝘥 𝘵𝘰 𝘪𝘵.

00:32:06.749 --> 00:32:07.749
𝘓𝘦𝘵'𝘴 𝘴𝘦𝘦 𝘩𝘰𝘸 𝘪𝘵 𝘨𝘰𝘦𝘴!

00:32:07.749 --> 00:32:09.980
𝘔𝘢𝘬𝘦 𝘴𝘶𝘳𝘦 𝘵𝘰 𝘴𝘶𝘣𝘴𝘤𝘳𝘪𝘣𝘦, 𝘴𝘰 𝘺𝘰𝘶 𝘥𝘰𝘯'𝘵 𝘮𝘪𝘴𝘴 𝘰𝘶𝘵.

00:32:09.980 --> 00:32:10.980
𝘛𝘩𝘢𝘯𝘬𝘴 𝘧𝘰𝘳 𝘸𝘢𝘵𝘤𝘩𝘪𝘯𝘨!

00:32:10.980 --> 00:32:12.809
𝘏𝘰𝘱𝘦 𝘺𝘰𝘶 𝘦𝘯𝘫𝘰𝘺𝘦𝘥, 𝘢𝘯𝘥 𝘴𝘦𝘦 𝘺𝘰𝘶 𝘯𝘦𝘹𝘵 𝘺𝘦𝘢𝘳!

