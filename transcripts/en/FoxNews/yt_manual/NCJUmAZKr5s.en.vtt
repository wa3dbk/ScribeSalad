OF ENTEC

00:08:16.668 --> 00:08:16.702
OF EN TC

00:08:16.702 --> 00:08:16.735
OF EN TEC

00:08:16.735 --> 00:08:16.852
OF EN TECH

00:08:16.852 --> 00:08:17.169
OF EN TEC

00:08:17.169 --> 00:08:17.202
OF ENTEEC

00:08:17.202 --> 00:08:17.369
OF ENTECH

00:08:17.369 --> 00:08:17.402
OF ENTECH -

00:08:17.402 --> 00:08:18.804
OF ENTECH --

00:08:18.804 --> 00:08:18.837
