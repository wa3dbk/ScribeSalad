8><c>point </c><00:00:01.499><c>that  </c><00:00:01.500><c>environment </c><00:00:01.501><c>definitely </c><00:00:01.502><c>played </c><00:00:01.503><c>a </c><00:00:01.504><c>role </c><00:00:01.505><c>in  </c><00:00:01.506><c>these </c><00:00:01.507><c>migrations </c><00:00:01.508><c>in </c><00:00:01.509><c>these </c><00:00:01.510><c>expansions  </c><00:00:01.511><c>certainly </c><00:00:01.512><c>this </c><00:00:01.513><c>isn't </c><00:00:01.514><c>only </c><00:00:01.515><c>about  </c><00:00:01.516><c>environmental </c><00:00:01.517><c>factors </c><00:00:01.518><c>but </c><00:00:01.519><c>in </c><00:00:01.520><c>both </c><00:00:01.521><c>cases  </c><00:00:01.522><c>it </c><00:00:01.523><c>would </c><00:00:01.524><c>be </c><00:00:01.525><c>very </c><00:00:01.526><c>difficult </c><00:00:01.527><c>to </c><00:00:01.528><c>explain  </c><00:00:01.529><c>what </c><00:00:01.530><c>happened </c><00:00:01.531><c>if </c><00:00:01.532><c>you </c><00:00:01.533><c>didn't </c><00:00:01.534><c>include  </c><00:00:01.535><c>these </c><00:00:01.536><c>environmental </c><00:00:01.537><c>factors</c>

