><c>negative </c><00:00:01.531><c>log </c><00:00:01.532><c>of </c><00:00:01.533><c>kw  </c><00:00:01.534><c>is </c><00:00:01.535><c>the </c><00:00:01.536><c>negative </c><00:00:01.537><c>log </c><00:00:01.538><c>of </c><00:00:01.539><c>1.0 </c><00:00:01.540><c>times </c><00:00:01.541><c>10 </c><00:00:01.542><c>to  </c><00:00:01.543><c>the </c><00:00:01.544><c>negative </c><00:00:01.545><c>14  </c><00:00:01.546><c>which </c><00:00:01.547><c>is </c><00:00:01.548><c>equal </c><00:00:01.549><c>to  </c><00:00:01.550><c>14.00  </c><00:00:01.551><c>so </c><00:00:01.552><c>we </c><00:00:01.553><c>can </c><00:00:01.554><c>plug </c><00:00:01.555><c>in </c><00:00:01.556><c>14.00  </c><00:00:01.557><c>in </c><00:00:01.558><c>for </c><00:00:01.559><c>pkw </c><00:00:01.560><c>which </c><00:00:01.561><c>gives </c><00:00:01.562><c>us </c><00:00:01.563><c>a </c><00:00:01.564><c>very </c><00:00:01.565><c>useful  </c><00:00:01.566><c>equation </c><00:00:01.567><c>that </c><00:00:01.568><c>says </c><00:00:01.569><c>that </c><00:00:01.570><c>the </c><00:00:01.571><c>ph </c><00:00:01.572><c>plus </c><00:00:01.573><c>the  </c><00:00:01.574><c>poh  </c><00:00:01.575><c>is </c><00:00:01.576><c>equal </c><00:00:01.577><c>to  </c><00:00:01.578><c>14.00 </c><00:00:01.579><c>and </c><00:00:01.580><c>this </c><00:00:01.581><c>equation </c><00:00:01.582><c>is </c><00:00:01.583><c>true </c><00:00:01.584><c>when </c><00:00:01.585><c>the  </c><00:00:01.586><c>temperature </c><00:00:01.587><c>is </c><00:00:01.588><c>25 </c><00:00:01.589><c>degrees </c><00:00:01.590><c>celsius</c>

