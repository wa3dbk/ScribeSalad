54><c>be </c><00:00:01.956><c>impacted </c><00:00:01.958><c>by </c><00:00:01.960><c>a  </c><00:00:01.962><c>natural </c><00:00:01.964><c>gas </c><00:00:01.966><c>war </c><00:00:01.968><c>with </c><00:00:01.970><c>moscow </c><00:00:01.972><c>i'll </c><00:00:01.974><c>see </c><00:00:01.976><c>you  </c><00:00:01.978><c>next </c><00:00:01.980><c>time</c>

