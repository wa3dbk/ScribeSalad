&lt;font color="#008000"&gt;Ich bin überwältigt,&lt;/font&gt;

00:33:13.932 --> 00:33:15.929
&lt;font color="#008000"&gt;wieder in den Staaten zu sein&lt;/font&gt;

00:33:16.570 --> 00:33:20.168
&lt;font color="#008000"&gt;und in San Francisco,&lt;/font&gt;
&lt;font color="#008000"&gt;bzw. in der Nähe davon.&lt;/font&gt;

00:33:20.891 --> 00:33:22.888
&lt;font color="#ffffff"&gt;* Sanfte Gitarrenklänge *&lt;/font&gt;

00:33:29.891 --> 00:33:33.889
&lt;font color="#ffffff"&gt;Nach 16 Jahren ist Susan&lt;/font&gt;
&lt;font color="#ffffff"&gt;endlich wieder in ihrer alten Heimat&lt;/font&gt;

00:33:34.530 --> 00:33:35.968
&lt;font color="#ffffff"&gt;im Sonnenstaat Kalifornien.&lt;/font&gt;

00:33:51.812 --> 00:33:55.928
&lt;font color="#008000"&gt;Mir fällt die ganze Anspannung&lt;/font&gt;
&lt;font color="#008000"&gt;der Reise&lt;/font&gt;

00:33:56.570 --> 00:34:00.968
&lt;font color="#008000"&gt;und der Reisevorbereitungen&lt;/font&gt;
&lt;font color="#008000"&gt;und alles von den Schultern.&lt;/font&gt;

00:34:01.610 --> 00:34:04.888
&lt;font color="#008000"&gt;Wegen des Windes&lt;/font&gt;
&lt;font color="#008000"&gt;und dem Aufs-Meer-hinausschauen.&lt;/font&gt;

00:34:06.332 --> 00:34:10.047
&lt;font color="#008000"&gt;Ich vermisse es, dass wir&lt;/font&gt;
&lt;font color="#008000"&gt;in der Schweiz kein Meer haben.&lt;/font&gt;

00:34:10.690 --> 00:34:11.408
&lt;font color="#008000"&gt;Ehrlich.&lt;/font&gt;

00:34:12.130 --> 00:34:14.128
&lt;font color="#ffffff"&gt;* Leises Gespräch und Lachen *&lt;/font&gt;

00:34:18.891 --> 00:34:20.888
&lt;font color="#ffff00"&gt;Wo gehen wir jetzt hin?&lt;/font&gt;

00:34:21.530 --> 00:34:25.808
&lt;font color="#008000"&gt;Jetzt gehen wir an die Pine Street&lt;/font&gt;
&lt;font color="#008000"&gt;und schauen, ob Bob noch dort wohnt.&lt;/font&gt;

00:34:26.572 --> 00:34:30.408
&lt;font color="#008000"&gt;Er hat mich&lt;/font&gt;
&lt;font color="#008000"&gt;eine Zeit lang aufgenommen,&lt;/font&gt;

00:34:31.047 --> 00:34:36.808
&lt;font color="#008000"&gt;als ich hier angekommen bin&lt;/font&gt;
&lt;font color="#008000"&gt;und versucht habe, Fuss zu fassen.&lt;/font&gt;

00:34:41.650 --> 00:34:44.168
&lt;font color="#008000"&gt;Ich habe etwas auf Google&lt;/font&gt;
&lt;font color="#008000"&gt;recherchiert.&lt;/font&gt;

00:34:46.491 --> 00:34:52.648
&lt;font color="#008000"&gt;Im besten Fall ist er noch dort,&lt;/font&gt;
&lt;font color="#008000"&gt;er lebt, und ist gerade zu Hause&lt;/font&gt;

00:34:53.290 --> 00:34:56.768
&lt;font color="#008000"&gt;und freut sich,&lt;/font&gt;
&lt;font color="#008000"&gt;mich nach so langer Zeit zu sehen.&lt;/font&gt;

00:35:01.051 --> 00:35:04.647
&lt;font color="#ffffff"&gt;Ein Überraschungsbesuch spät abends&lt;/font&gt;
&lt;font color="#ffffff"&gt;bei einem Bekannten&lt;/font&gt;

00:35:05.290 --> 00:35:07.648
&lt;font color="#ffffff"&gt;nach fast 20 Jahren:&lt;/font&gt;
&lt;font color="#ffffff"&gt;Susan will es versuchen.&lt;/font&gt;

00:35:19.570 --> 00:35:23.248
&lt;font color="#008000"&gt;Jetzt bin ich leicht verwirrt.&lt;/font&gt;
&lt;font color="#008000"&gt;Hier ist doch die Fünf ...&lt;/font&gt;

00:35:25.811 --> 00:35:27.448
&lt;font color="#008000"&gt;Ah, hier.&lt;/font&gt;

00:35:32.011 --> 00:35:34.608
&lt;font color="#008000"&gt;Die Klingel sieht kaputt aus.&lt;/font&gt;
&lt;font color="#ffff00"&gt;- Klopfen.&lt;/font&gt;

00:35:36.491 --> 00:35:38.487
&lt;font color="#ffff00"&gt;Oh, schau. Es kommt jemand.&lt;/font&gt;

00:36:25.611 --> 00:36:27.688
&lt;font color="#008000"&gt;As we all are.&lt;/font&gt;

00:36:34.211 --> 00:36:36.607
&lt;font color="#008000"&gt;Es übertrifft&lt;/font&gt;
&lt;font color="#008000"&gt;alle meine Erwartungen.&lt;/font&gt;

00:36:37.290 --> 00:36:41.208
&lt;font color="#008000"&gt;Zuerst dachte ich eher:&lt;/font&gt;
&lt;font color="#008000"&gt;"Hoffentlich ist er nicht zu Hause."&lt;/font&gt;

00:36:41.850 --> 00:36:43.288
&lt;font color="#008000"&gt;"Er wird zu Tode erschrecken."&lt;/font&gt;

00:36:43.930 --> 00:36:47.087
&lt;font color="#008000"&gt;Aber er war so offen:&lt;/font&gt;
&lt;font color="#008000"&gt;"Hey, wanna come in?"&lt;/font&gt;

00:37:16.209 --> 00:37:18.048
&lt;font color="#ffff00"&gt;"Who is this?"&lt;/font&gt;

00:37:20.491 --> 00:37:22.287
&lt;font color="#ffff00"&gt;You just say: "Hello, come in."&lt;/font&gt;

00:37:44.490 --> 00:37:46.967
&lt;font color="#ffffff"&gt;Auch Vernon&lt;/font&gt;
&lt;font color="#ffffff"&gt;ist ein Freund von damals,&lt;/font&gt;

00:37:47.609 --> 00:37:51.007
&lt;font color="#ffffff"&gt;den Susan in all diesen Jahren&lt;/font&gt;
&lt;font color="#ffffff"&gt;aus den Augen verloren hat.&lt;/font&gt;

00:37:51.649 --> 00:37:53.087
&lt;font color="#ffffff"&gt;Aber Bob kann helfen.&lt;/font&gt;

00:37:54.291 --> 00:37:56.807
&lt;font color="#008000"&gt;Ich habe von Bob&lt;/font&gt;
&lt;font color="#008000"&gt;diese Nummer bekommen.&lt;/font&gt;

00:37:57.530 --> 00:37:59.527
&lt;font color="#008000"&gt;So, the 510-number?&lt;/font&gt;

00:38:01.610 --> 00:38:03.447
&lt;font color="#00ffff"&gt;Yeah, try that one.&lt;/font&gt;

00:38:05.810 --> 00:38:07.807
&lt;font color="#008000"&gt;Well, well, well.&lt;/font&gt;

00:38:31.130 --> 00:38:32.127
&lt;font color="#008000"&gt;Bye.&lt;/font&gt;

00:38:32.850 --> 00:38:34.847
&lt;font color="#008000"&gt;Bye, Vernon.&lt;/font&gt;

00:38:37.089 --> 00:38:39.087
&lt;font color="#008000"&gt;Er ist in Oakland.&lt;/font&gt;

00:38:39.729 --> 00:38:41.647
&lt;font color="#008000"&gt;Er hat morgen früh Zeit.&lt;/font&gt;

00:38:43.169 --> 00:38:44.167
&lt;font color="#008000"&gt;Ja.&lt;/font&gt;

00:38:44.851 --> 00:38:47.847
&lt;font color="#008000"&gt;Es war gleich "Hoi!",&lt;/font&gt;
&lt;font color="#008000"&gt;als wäre nichts gewesen.&lt;/font&gt;

00:38:48.691 --> 00:38:52.167
&lt;font color="#ffffff"&gt;* Instrumentalversion&lt;/font&gt;
&lt;font color="#ffffff"&gt;von "California Dreamin'" *&lt;/font&gt;

00:38:52.808 --> 00:38:54.247
&lt;font color="#00ffff"&gt;Bye-bye.&lt;/font&gt;
&lt;font color="#008000"&gt;- Bye, Bob.&lt;/font&gt;

00:38:54.889 --> 00:38:55.727
&lt;font color="#008000"&gt;Bye.&lt;/font&gt;

00:39:06.850 --> 00:39:10.767
&lt;font color="#ffffff"&gt;Kaum gelandet hatte Susan&lt;/font&gt;
&lt;font color="#ffffff"&gt;bereits das erste Erfolgserlebnis.&lt;/font&gt;

00:39:11.408 --> 00:39:13.247
&lt;font color="#ffffff"&gt;Ganz anders Ando und Giada.&lt;/font&gt;

00:39:13.889 --> 00:39:15.887
&lt;font color="#ffffff"&gt;Ihnen steht heute&lt;/font&gt;
&lt;font color="#ffffff"&gt;ein trauriger Besuch bevor.&lt;/font&gt;

00:39:16.529 --> 00:39:17.967
&lt;font color="#ffffff"&gt;Ando zeigt seiner Freundin&lt;/font&gt;

00:39:18.609 --> 00:39:21.647
&lt;font color="#ffffff"&gt;das tragischste Kapitel&lt;/font&gt;
&lt;font color="#ffffff"&gt;in Armeniens Vergangenheit.&lt;/font&gt;

00:39:22.289 --> 00:39:25.206
&lt;font color="#ffffff"&gt;Beim Völkermord&lt;/font&gt;
&lt;font color="#ffffff"&gt;während des Ersten Weltkrieges&lt;/font&gt;

00:39:25.849 --> 00:39:29.567
&lt;font color="#ffffff"&gt;haben die türkischen Herrscher&lt;/font&gt;
&lt;font color="#ffffff"&gt;über 1,5 Mio. Christen umgebracht.&lt;/font&gt;

00:39:31.330 --> 00:39:34.847
&lt;font color="#00ffff"&gt;Ich erinnere mich,&lt;/font&gt;
&lt;font color="#00ffff"&gt;dass ich mit meinem Vater hier war.&lt;/font&gt;

00:39:35.491 --> 00:39:36.927
&lt;font color="#008000"&gt;Du warst schon mal hier?&lt;/font&gt;
&lt;font color="#00ffff"&gt;- Ja.&lt;/font&gt;

00:39:38.730 --> 00:39:41.247
&lt;font color="#ffffff"&gt;Ando war sechs,&lt;/font&gt;
&lt;font color="#ffffff"&gt;als er mit seinem Vater&lt;/font&gt;

00:39:41.889 --> 00:39:44.127
&lt;font color="#ffffff"&gt;das Denkmal&lt;/font&gt;
&lt;font color="#ffffff"&gt;zu Ehren der Opfer besucht hat.&lt;/font&gt;

00:39:44.769 --> 00:39:46.887
&lt;font color="#ffffff"&gt;Sein Vater&lt;/font&gt;
&lt;font color="#ffffff"&gt;ist vor vier Jahren gestorben.&lt;/font&gt;

00:39:49.050 --> 00:39:51.327
&lt;font color="#ffffff"&gt;Das ewige Feuer soll dafür sorgen,&lt;/font&gt;

00:39:51.969 --> 00:39:55.887
&lt;font color="#ffffff"&gt;dass der Völkermord auch über 100&lt;/font&gt;
&lt;font color="#ffffff"&gt;Jahre später nicht vergessen wird.&lt;/font&gt;

00:40:00.969 --> 00:40:03.087
&lt;font color="#ffffff"&gt;* Eindringlicher, hoher Gesang *&lt;/font&gt;

00:40:27.770 --> 00:40:30.047
&lt;font color="#ffffff"&gt;Dieser Ort löst bei Ando vieles aus:&lt;/font&gt;

00:40:30.689 --> 00:40:34.166
&lt;font color="#ffffff"&gt;Trauer und Betroffenheit,&lt;/font&gt;
&lt;font color="#ffffff"&gt;aber auch schöne Erinnerungen.&lt;/font&gt;

00:40:36.169 --> 00:40:39.446
&lt;font color="#00ffff"&gt;Ich weiss nicht,&lt;/font&gt;
&lt;font color="#00ffff"&gt;wie ich das in Worte fassen soll.&lt;/font&gt;

00:40:40.088 --> 00:40:42.047
&lt;font color="#00ffff"&gt;Es ist ein tolles Gefühl,&lt;/font&gt;
&lt;font color="#00ffff"&gt;hier zu sein.&lt;/font&gt;

00:40:43.130 --> 00:40:44.287
&lt;font color="#00ffff"&gt;Ja ...&lt;/font&gt;

00:40:49.570 --> 00:40:51.566
&lt;font color="#00ffff"&gt;Einerseits ist es schön,&lt;/font&gt;

00:40:52.209 --> 00:40:54.366
&lt;font color="#00ffff"&gt;andererseits Erinnerungen&lt;/font&gt;
&lt;font color="#00ffff"&gt;an meinen Vater,&lt;/font&gt;

00:40:55.009 --> 00:40:56.526
&lt;font color="#00ffff"&gt;an die Zeit, als ich klein war.&lt;/font&gt;

00:40:57.610 --> 00:40:59.607
&lt;font color="#00ffff"&gt;Es ist schön, zurück zu sein.&lt;/font&gt;

00:41:01.289 --> 00:41:04.287
&lt;font color="#00ffff"&gt;Ich weiss nicht,&lt;/font&gt;
&lt;font color="#00ffff"&gt;wie ich mich ausdrücken soll.&lt;/font&gt;

00:41:04.929 --> 00:41:06.367
&lt;font color="#00ffff"&gt;Es sind schöne Erinnerungen.&lt;/font&gt;

00:41:07.009 --> 00:41:11.366
&lt;font color="#00ffff"&gt;Auch an das Respektzollen&lt;/font&gt;
&lt;font color="#00ffff"&gt;an die verstorbenen Armenier.&lt;/font&gt;

00:41:13.770 --> 00:41:15.766
&lt;font color="#00ffff"&gt;Ich hatte vorher Gänsehaut.&lt;/font&gt;

00:41:16.408 --> 00:41:19.367
&lt;font color="#00ffff"&gt;Ich musste mit den Tränen kämpfen.&lt;/font&gt;
&lt;font color="#00ffff"&gt;Ein schöner Moment.&lt;/font&gt;

00:41:20.009 --> 00:41:21.647
&lt;font color="#ffffff"&gt;* Sanfte, dunkle Klänge *&lt;/font&gt;

00:41:34.609 --> 00:41:38.288
&lt;font color="#ffffff"&gt;Nächste Woche landet Ando&lt;/font&gt;
&lt;font color="#ffffff"&gt;mitten in seiner Kindheit.&lt;/font&gt;

00:41:38.928 --> 00:41:41.247
&lt;font color="#ffffff"&gt;In diesem Haus&lt;/font&gt;
&lt;font color="#ffffff"&gt;wohnte er mit seiner Familie,&lt;/font&gt;

00:41:41.889 --> 00:41:43.616
&lt;font color="#ffffff"&gt;bis er mit sieben flüchten musste.&lt;/font&gt;

00:41:45.849 --> 00:41:48.046
&lt;font color="#00ffff"&gt;Es gab nichts. Wir hatten nichts.&lt;/font&gt;

00:41:48.889 --> 00:41:52.046
&lt;font color="#00ffff"&gt;Es war genau so.&lt;/font&gt;
&lt;font color="#00ffff"&gt;Das ist meine Herkunft.&lt;/font&gt;

00:41:55.049 --> 00:41:58.487
&lt;font color="#ffffff"&gt;Und in den USA erwartet Susan&lt;/font&gt;
&lt;font color="#ffffff"&gt;das Wiedersehen mit ihrem Vater.&lt;/font&gt;

00:41:59.129 --> 00:42:02.366
&lt;font color="#008000"&gt;Ich sehe jemanden. Aber ich glaube,&lt;/font&gt;
&lt;font color="#008000"&gt;der ist nicht lang genug.&lt;/font&gt;

00:42:07.809 --> 00:42:11.007
&lt;font color="#008000"&gt;Nein, das ist nicht Dad.&lt;/font&gt;
&lt;font color="#008000"&gt;Nein, das ist nicht Dad.&lt;/font&gt;

